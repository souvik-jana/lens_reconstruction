# Add to .gitignore
# macOS system files
.DS_Store
*/.DS_Store
**/.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python cache files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
env/
.env
.venv

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.Trash-*
Thumbs.db

# Output folders
**/outputs/*
!**/outputs/*.dvc

# Local lens catalogs
examples/catalog/

# Large data/binary file types
*.json
*.txt
*.pdf
*.png
*.pkl
*.h5
*.hdf5
*.aux
*.log
Diagnosis/
handoff.md

# comparison-analysis only: track report PDF (plots live in the report)
!comparison-analysis/report/
!comparison-analysis/report/**/
!comparison-analysis/report/**/*.pdf

# scratch analysis, not tracked
q-phi-analysis/

# captured run logs
*.out

# tutorial run products, regenerable
tutorial/outputs/
tutorial/outputs_nb/

# graphify skill cache, machine-specific and regenerable
graphify-out/
